{
  "schema_version": 1,
  "project": "NotepadNext",
  "advisory_policy": {
    "provider": "OSV.dev",
    "commit_query": "https://api.osv.dev/v1/query",
    "refresh_command": "python scripts/dependency_inventory.py --refresh-advisories --security-gate",
    "exceptions": [
      {
        "dependency": "Qt 6",
        "owner": "SysAdminDoc",
        "rationale": "Qt is supplied by the build host or platform package manager; OSV commit queries do not identify a system installation. The resolved Qt version and license choice remain explicit in this inventory."
      },
      {
        "dependency": "CPM.cmake",
        "owner": "SysAdminDoc",
        "rationale": "CPM.cmake is a vendored build-time helper rather than shipped application code; its source hash and version are checked locally."
      },
      {
        "dependency": "Lua 5.3",
        "owner": "SysAdminDoc",
        "rationale": "Lua is a vendored source snapshot without upstream VCS metadata in this checkout; its version, license notice, and source-tree hash are emitted in the SBOM."
      },
      {
        "dependency": "Scintilla",
        "owner": "SysAdminDoc",
        "rationale": "Scintilla is a vendored source snapshot without upstream VCS metadata in this checkout; its version, license notice, and source-tree hash are emitted in the SBOM."
      },
      {
        "dependency": "Lexilla",
        "owner": "SysAdminDoc",
        "rationale": "Lexilla is a vendored source snapshot without upstream VCS metadata in this checkout; its version, license notice, and source-tree hash are emitted in the SBOM."
      },
      {
        "dependency": "uchardet",
        "owner": "SysAdminDoc",
        "rationale": "uchardet is a vendored source snapshot without upstream VCS metadata in this checkout; its version, license notice, and source-tree hash are emitted in the SBOM."
      }
    ]
  },
